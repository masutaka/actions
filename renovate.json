{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "schedule": ["* * 1-3 * *"],
  "minimumReleaseAge": "7 days",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "customManagers": [
    {
      "description": "GitHub Release から取得するバイナリの VERSION と CHECKSUM を同時に更新する",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: depName=(?<depName>\\S+)\\s+\\w+_VERSION: (?<currentValue>\\S+)\\s+\\w+_CHECKSUM: (?<currentDigest>[0-9a-f]{64})"
      ],
      "datasourceTemplate": "github-release-attachments"
    }
  ]
}
